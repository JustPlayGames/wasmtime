test compile precise-output
set unwind_info=false
set omit_frame_pointers=true
set enable_probestack=true
set probestack_strategy=inline
target x86_64

; A frame large enough to be probed keeps its frame pointer.
function %big() -> i64 {
    ss0 = explicit_slot 8192
block0:
    v0 = stack_addr.i64 ss0
    v1 = load.i64 v0
    return v1
}

; VCode:
;   pushq %rbp
;   movq %rsp, %rbp
;   subq $0x1000, %rsp
;   movl $0x0, (%rsp)
;   subq $0x1000, %rsp
;   movl $0x0, (%rsp)
;   addq $0x2000, %rsp
;   subq $0x2000, %rsp
; block0:
;   movq <offset:1>+(%rsp), %rax
;   addq $0x2000, %rsp
;   movq %rbp, %rsp
;   popq %rbp
;   retq
;
