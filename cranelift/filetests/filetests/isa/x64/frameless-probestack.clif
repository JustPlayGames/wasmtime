;   movq %rsp, %rbp
;   subq $0x1000, %rsp
;   movl $0, (%rsp)
;   subq $0x1000, %rsp
;   movl $0, (%rsp)
;   addq $0x2000, %rsp
;   subq $0x2000, %rsp
; block1: ; offset 0x2e
;   movq (%rsp), %rax
;   addq $0x2000, %rsp
;   movq %rbp, %rsp
;   popq %rbp
;   retq

function %small() -> i64 {
    ss0 = explicit_slot 4064
block0:
    v0 = stack_addr.i64 ss0
    v1 = load.i64 v0
    return v1
}

