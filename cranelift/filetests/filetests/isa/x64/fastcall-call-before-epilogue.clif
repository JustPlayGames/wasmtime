;   movq %rsp, %rbp
;   subq $0x20, %rsp
; block1: ; offset 0x8
;   movabsq $0, %rcx ; reloc_external Abs8 %g 0
;   callq *%rcx
;   movl $0x2a, %eax
;   addq $0x20, %rsp
;   movq %rbp, %rsp
;   popq %rbp
;   retq

function %call_then_return_systemv() system_v {
    fn0 = %g() system_v

block0:
    call fn0()
    return
}

