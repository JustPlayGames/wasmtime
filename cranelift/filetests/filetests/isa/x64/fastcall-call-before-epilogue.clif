test compile precise-output
set unwind_info=true
target x86_64-pc-windows-msvc

;; Windows x64: a call must not return into the epilogue, or the unwinder
;; takes the frame as one that is already leaving and skips its handler.

function %call_then_return() windows_fastcall {
    fn0 = %g() windows_fastcall

block0:
    call fn0()
    return
}

; VCode:
;   pushq %rbp
;   unwind PushFrameRegs { offset_upward_to_caller_sp: 16 }
;   movq %rsp, %rbp
;   unwind FramePointerSet
;   unwind DefineNewFrame { offset_upward_to_caller_sp: 16, offset_downward_to_clobbers: 0 }
;   subq $0x20, %rsp
; block0:
;   load_ext_name %g+0, %rax
;   call    *%rax
;   nop
;   addq $0x20, %rsp
;   movq %rbp, %rsp
;   popq %rbp
;   retq
;
; Disassembled:
; block0: ; offset 0x0
;   pushq %rbp
;   movq %rsp, %rbp
;   subq $0x20, %rsp
; block1: ; offset 0x8
;   movabsq $0, %rax ; reloc_external Abs8 %g 0
;   callq *%rax
;   nop
;   addq $0x20, %rsp
;   movq %rbp, %rsp
;   popq %rbp
;   retq

function %try_call_then_return() windows_fastcall {
    sig0 = () windows_fastcall
    fn0 = %g() windows_fastcall

block0:
    try_call fn0(), sig0, block1(), [ default: block2(exn0) ]

block1:
    return

block2(v0: i64):
    trap user1
}

; VCode:
;   pushq %rbp
;   unwind PushFrameRegs { offset_upward_to_caller_sp: 16 }
;   movq %rsp, %rbp
;   unwind FramePointerSet
;   unwind DefineNewFrame { offset_upward_to_caller_sp: 16, offset_downward_to_clobbers: 0 }
;   subq $0x20, %rsp
; block0:
;   load_ext_name %g+0, %r8
;   call    *%r8; jmp MachLabel(1); catch [default: MachLabel(2)]
; block1:
;   nop
;   addq $0x20, %rsp
;   movq %rbp, %rsp
;   popq %rbp
;   retq
; block2:
;   ud2
;
; Disassembled:
; block0: ; offset 0x0
;   pushq %rbp
;   movq %rsp, %rbp
;   subq $0x20, %rsp
; block1: ; offset 0x8
;   movabsq $0, %r8 ; reloc_external Abs8 %g 0
;   callq *%r8
; block2: ; offset 0x15
;   nop
;   addq $0x20, %rsp
;   movq %rbp, %rsp
;   popq %rbp
;   retq
; block3: ; offset 0x1f
;   ud2 ; trap: user1

function %call_then_work() -> i64 windows_fastcall {
    fn0 = %g() windows_fastcall

block0:
    call fn0()
    v0 = iconst.i64 42
    return v0
}

; VCode:
;   pushq %rbp
;   unwind PushFrameRegs { offset_upward_to_caller_sp: 16 }
;   movq %rsp, %rbp
;   unwind FramePointerSet
;   unwind DefineNewFrame { offset_upward_to_caller_sp: 16, offset_downward_to_clobbers: 0 }
;   subq $0x20, %rsp
; block0:
;   load_ext_name %g+0, %rcx
;   call    *%rcx
;   movl $0x2a, %eax
;   addq $0x20, %rsp
;   movq %rbp, %rsp
;   popq %rbp
;   retq
