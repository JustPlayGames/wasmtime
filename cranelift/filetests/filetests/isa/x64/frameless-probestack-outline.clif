test compile precise-output
set unwind_info=false
set omit_frame_pointers=true
set enable_probestack=true
set probestack_strategy=outline
target x86_64

; The outlined probe leaves RSP as it found it: a probed frame needs no frame
; pointer.
function %big() -> i64 {
    ss0 = explicit_slot 8192
block0:
    v0 = stack_addr.i64 ss0
    v1 = load.i64 v0
    return v1
}

; VCode:
;   movl $0x2008, %eax
;   call    LibCall(Probestack)
;   subq $0x2008, %rsp
; block0:
;   movq <offset:1>+(%rsp), %rax
;   addq $0x2008, %rsp
;   retq
;
; Disassembled:
; block0: ; offset 0x0
;   movl $0x2008, %eax
;   callq 0xa ; reloc_external CallPCRel4 %Probestack -4
;   subq $0x2008, %rsp
; block1: ; offset 0x11
;   movq (%rsp), %rax
;   addq $0x2008, %rsp
;   retq

