test compile precise-output
set unwind_info=true
set preserve_frame_pointers=true
target x86_64-pc-windows-msvc

;; `try_call` to a `windows_fastcall` callee: the payload arrives in `rax`
;; (`RtlUnwindEx`'s `ReturnValue`) and, as on a normal return, only the
;; volatile registers are clobbered: the Windows unwinder restores the
;; non-volatile ones from each frame's UNWIND_INFO.

function %f0(i64) -> i64 windows_fastcall {
    sig0 = (i64) windows_fastcall
    fn0 = %g(i64) windows_fastcall

    block0(v0: i64):
        try_call fn0(v0), sig0, block1(), [ tag1: block2(exn0) ]

    block1:
        return v0

    block2(v1: i64):
        v2 = iadd v0, v1
        return v2
}

; VCode:
;   pushq %rbp
;   unwind PushFrameRegs { offset_upward_to_caller_sp: 16 }
;   movq %rsp, %rbp
;   unwind FramePointerSet
;   unwind DefineNewFrame { offset_upward_to_caller_sp: 16, offset_downward_to_clobbers: 16 }
;   subq $0x30, %rsp
;   movq %r12, 0x20(%rsp)
;   unwind SaveReg { clobber_offset: 0, reg: p12i }
; block0:
;   movq %rcx, %r12
;   load_ext_name %g+0, %r8
;   call    *%r8; jmp MachLabel(1); catch [tag1: MachLabel(2)]
; block1:
;   movq %r12, %rax
;   movq 0x20(%rsp), %r12
;   addq $0x30, %rsp
;   movq %rbp, %rsp
;   popq %rbp
;   retq
; block2:
;   movq %r12, %rcx
;   leaq (%rcx, %rax), %rax
;   movq 0x20(%rsp), %r12
;   addq $0x30, %rsp
;   movq %rbp, %rsp
;   popq %rbp
;   retq
;
; Disassembled:
; block0: ; offset 0x0
;   pushq %rbp
;   movq %rsp, %rbp
;   subq $0x30, %rsp
;   movq %r12, 0x20(%rsp)
; block1: ; offset 0xd
;   movq %rcx, %r12
;   movabsq $0, %r8 ; reloc_external Abs8 %g 0
;   callq *%r8
; block2: ; offset 0x1d
;   movq %r12, %rax
;   movq 0x20(%rsp), %r12
;   addq $0x30, %rsp
;   movq %rbp, %rsp
;   popq %rbp
;   retq
; block3: ; offset 0x2e
;   movq %r12, %rcx
;   addq %rcx, %rax
;   movq 0x20(%rsp), %r12
;   addq $0x30, %rsp
;   movq %rbp, %rsp
;   popq %rbp
;   retq

function %f1(i64, f64) -> f64 windows_fastcall {
    sig0 = (i64) windows_fastcall
    fn0 = %g(i64) windows_fastcall

    block0(v0: i64, v1: f64):
        try_call fn0(v0), sig0, block1(), [ default: block2(exn0, exn1) ]

    block1:
        return v1

    block2(v2: i64, v3: i64):
        v4 = fcvt_from_sint.f64 v2
        v5 = fadd v1, v4
        return v5
}

